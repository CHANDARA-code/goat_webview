{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@goat/bridge-mock": ["../packages/bridge-mock/src/index.ts"],
      "@goat/bridge-mock/*": ["../packages/bridge-mock/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "docusaurus.config.ts",
    "sidebars.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "test",
    "scripts"
  ]
}
