{
  "name": "miniapp-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && esbuild src/miniapp-bridge.ts --minify --bundle --outfile=dist/miniapp-bridge.min.js",
    "build:sdk": "esbuild src/miniapp-bridge.ts --minify --bundle --outfile=dist/miniapp-bridge.min.js",
    "test": "esbuild src/index.ts src/miniapp-bridge.ts src/hooks/*.ts src/__tests__/*.test.ts --outdir=dist-test --format=esm --platform=node && node --test dist-test/__tests__/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "terser": "^5.39.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
