{
  "name": "react-native-goat-webview",
  "version": "1.0.0-alpha.2",
  "description": "High-Performance Embedded Mini-App Engine for React Native powered by Goat WebView",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "!src/__tests__",
    "lib",
    "android/build.gradle",
    "android/gradle.properties",
    "android/settings.gradle",
    "android/src",
    "ios",
    "react-native-goat-webview.podspec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest",
    "build:cjs": "tsc -p tsconfig.build.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "prepare": "npm run build"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "GoatWebViewSpecs",
    "type": "all",
    "jsRootDir": "src",
    "android": {
      "package": "com.goat.webview.rn"
    }
  },
  "keywords": [
    "react-native",
    "webview",
    "miniapp",
    "goat-webview",
    "turbomodule",
    "fabric",
    "android"
  ],
  "author": "Goat Engineering Team",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.18",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-native": "^0.76.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "detox": {
    "test-runner": "jest"
  }
}
