{
  "name": "@goat/core",
  "version": "1.0.0",
  "description": "Goat WebView Core — Zero-Trust Security, SSRF Defenses, Network Policies & Universal Types",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js",
      "default": "./dist/security/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "keywords": [
    "goat",
    "core",
    "security",
    "ssrf",
    "zero-trust",
    "dns-rebinding"
  ],
  "author": "Goat Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.7.3"
  }
