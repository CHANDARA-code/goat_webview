{
  "name": "@goat/server",
  "version": "1.4.0",
  "description": "Tooling Backend Service, CDP Relay, Trace Persistence & Telemetry Gateway for Goat WebView",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/goat-server",
    "!dist/goat-server*",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "goat-server": "bin/goat-server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:binary": "bun build --compile src/main.ts --outfile dist/goat-server",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run --testTimeout 30000",
    "test:watch": "vitest"
  },
  "keywords": [
    "goat",
    "cdp",
    "telemetry",
    "devtools",
    "server",
    "miniapp"
  ],
  "author": "Goat Engineering Team",
  "license": "MIT",
  "dependencies": {
    "@types/express": "^4.17.21",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.14",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
