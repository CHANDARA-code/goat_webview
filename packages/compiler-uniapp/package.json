{
  "name": "@goat/compiler-uniapp",
  "version": "0.1.0",
  "description": "Uni-app (Vue 3 / SFC) Compiler Adapter & JSAPI Bridge for Goat WebView",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./preprocessor": {
      "types": "./dist/preprocessor/index.d.ts",
      "import": "./dist/preprocessor/index.js",
      "default": "./dist/preprocessor/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./bundler": {
      "types": "./dist/bundler/index.d.ts",
      "import": "./dist/bundler/index.js",
      "default": "./dist/bundler/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "goat",
    "uniapp",
    "compiler",
    "vite-plugin",
    "mini-program",
    "vue3",
    "webview"
  ],
  "author": "Goat Engineering Team",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
