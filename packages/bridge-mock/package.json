{
  "name": "@goat/bridge-mock",
  "version": "1.4.0",
  "type": "module",
  "description": "Zero-dependency hermetic browser simulation engine, in-memory state machine, DOM modals, and CDP trace client for Goat WebView",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
