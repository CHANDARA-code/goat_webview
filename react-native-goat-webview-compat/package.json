{
  "name": "react-native-goat-webview-compat",
  "version": "1.0.0-alpha.2",
  "description": "Drop-in compatibility adapter for react-native-webview backed by Goat WebView.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "sideEffects": false,
  "files": [
    "lib",
    "src",
    "!src/__tests__",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest",
    "test:lint-rule": "node eslint-plugin/__tests__/no-retained-compat-config.test.js",
    "check:size": "bash scripts/check-bundle-size.sh",
    "bench": "bash scripts/bench-rn-compat.sh",
    "build:cjs": "tsc -p tsconfig.build.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "typecheck": "npm run build:types",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-goat-webview": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.18",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-native": "^0.76.0",
    "react-native-goat-webview": "file:../react-native-goat-webview",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "react-native",
    "webview",
    "react-native-webview",
    "compat",
    "goat-webview",
    "migration"
  ],
  "author": "Goat Engineering Team",
  "license": "MIT"
}
